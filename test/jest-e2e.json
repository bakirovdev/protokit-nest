{
 "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-test\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@src/(.*)$": "<rootDir>/src/$1",
    "^@base/(.*)$": "<rootDir>/src/base/$1",
    "^@generated/(.*)$": "<rootDir>/generated/$1"
  },
  "testTimeout": 30000,
  "globalSetup": "<rootDir>/test/global-setup.ts"
}
